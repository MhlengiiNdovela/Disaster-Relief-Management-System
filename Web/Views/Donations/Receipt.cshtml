@using GiftOfTheGivers.Helpers
@model Service.Models.Donation
@{
    ViewData["Title"] = "Tax certificate";
}

<h1>Donation received</h1>
<p>Thank you, @Model.Description. Your placeholder tax certificate is ready.</p>

<div class="card col-lg-8">
    <div class="card-body">
        <h2 class="h4">Gift of the Givers</h2>
        <h3 class="h5">Donation tax certificate</h3>
        <dl class="row mb-0">
            <dt class="col-sm-4">Certificate number</dt>
            <dd class="col-sm-8">@CertificateFormatter.FormatNumber(Model.DonationId, DateOnly.FromDateTime(Model.DonationDate))</dd>
            <dt class="col-sm-4">Donor</dt>
            <dd class="col-sm-8">@Model.Description</dd>
            <dt class="col-sm-4">Amount</dt>
            <dd class="col-sm-8">@Model.Currency @Model.Amount?.ToString("N2")</dd>
            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">@Model.DonationType</dd>
            <dt class="col-sm-4">Date</dt>
            <dd class="col-sm-8">@Model.DonationDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">Relief project</dt>
            <dd class="col-sm-8">@Model.Project.ProjectName</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a class="btn btn-primary" asp-action="Certificate" asp-route-id="@Model.DonationId">Download PDF certificate</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Donate again</a>
</p>
