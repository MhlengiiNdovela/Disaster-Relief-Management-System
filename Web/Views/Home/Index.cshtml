@{
    ViewData["Title"] = "Home";
}

<div class="landing">
    <div class="landing-carousel">
        @await Html.PartialAsync("_HomeCarousel")
    </div>

    <section class="welcome-panel">
        <img class="hero-logo" src="~/images/logo.jpg" alt="Gift of the Givers logo" />
        <div>
            <h1>Relief, coordinated when it matters</h1>
            <p class="lead">A central place for the Foundation to record donations, welcome volunteers, and keep relief projects moving.</p>
            <a class="btn btn-primary" asp-controller="Donations" asp-action="Index">Donate</a>
            <a class="btn btn-outline-primary" asp-controller="Volunteers" asp-action="Register">Volunteer</a>
        </div>
    </section>

    <section class="feature-grid">
        <a class="feature-card" asp-controller="Donations" asp-action="Index">
            <h2>Donate</h2>
            <p>Give once or monthly in ZAR, USD, or EUR, and download a tax certificate.</p>
        </a>
        <a class="feature-card" asp-controller="Volunteers" asp-action="Register">
            <h2>Volunteer</h2>
            <p>Register your skills and availability so teams can match you to a response.</p>
        </a>
        <a class="feature-card" asp-controller="ReliefRequests" asp-action="Index">
            <h2>Relief requests</h2>
            <p>Track what affected communities still need and what has already been assigned.</p>
        </a>
    </section>
</div>
