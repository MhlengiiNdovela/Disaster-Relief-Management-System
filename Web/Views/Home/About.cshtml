@{
    ViewData["Title"] = "About";
}

<h1>About the relief desk</h1>
<p class="page-intro">This system gives Gift of the Givers one place to coordinate people, money, and projects during a disaster response.</p>

<div class="feature-grid">
    <article class="feature-card">
        <h2>Donors</h2>
        <p>Guests can give without an account. Registered donors can return and see their own gifts.</p>
    </article>
    <article class="feature-card">
        <h2>Volunteers</h2>
        <p>People offer skills and availability. Employees see those sign-ups on the dashboard.</p>
    </article>
    <article class="feature-card">
        <h2>Employees</h2>
        <p>Staff post relief updates, review donations, and keep the response visible to the team.</p>
    </article>
</div>
