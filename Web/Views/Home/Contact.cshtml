@{
    ViewData["Title"] = "Contact";
}

<h1>Contact</h1>
<p>This prototype supports Gift of the Givers disaster-relief coordination. Use the form to leave an enquiry for the project team.</p>

@if (TempData["ContactSent"] is string sent)
{
    <div class="alert alert-success">@sent</div>
}

<div class="row">
    <div class="col-md-6">
        <h2 class="h5">Foundation</h2>
        <p>Gift of the Givers Foundation<br />South Africa<br /><a href="https://giftofthegivers.org" rel="noopener">giftofthegivers.org</a></p>
    </div>
    <div class="col-md-6">
        <form method="post" asp-action="Contact">
            <div class="mb-3">
                <label class="form-label" for="name">Name</label>
                <input class="form-control" id="name" name="name" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="message">Message</label>
                <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
            </div>
            <button class="btn btn-primary">Send message</button>
        </form>
    </div>
</div>
