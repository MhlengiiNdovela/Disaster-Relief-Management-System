<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
    <DockerfileContext>..\Disaster Relief Management System</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="App_Images\**" />
    <Content Remove="App_Images\**" />
    <EmbeddedResource Remove="App_Images\**" />
    <None Remove="App_Images\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service\Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Scripts\" />
  </ItemGroup>

</Project>
