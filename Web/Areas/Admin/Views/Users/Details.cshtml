@model Service.Models.User

@{
    ViewData["Title"] = "User Details";
}

<h1>User Details</h1>

<dl class="row">
    <dt class="col-sm-2">UserId</dt>
    <dd class="col-sm-10">@Model.UserId</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">FirstName</dt>
    <dd class="col-sm-10">@Model.FirstName</dd>

    <dt class="col-sm-2">Role</dt>
    <dd class="col-sm-10">@Model.Role</dd>
</dl>

<a class="btn btn-secondary" asp-area="Admin" asp-controller="Users" asp-action="Index">Back</a>
